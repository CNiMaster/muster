{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "rootDir": "src",
    "outDir": "dist/client-types",
    "tsBuildInfoFile": ".tsbuildinfo/client.tsbuildinfo",
    "composite": true,
    "jsx": "react-jsx"
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/shared/**/*.ts"]
}
